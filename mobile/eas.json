{
  "cli": {
    "version": ">= 22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "closed": {
      "android": {
        "serviceAccountKeyPath": "./.secrets/google-play-service-account.json",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6804283601"
      },
      "android": {
        "serviceAccountKeyPath": "./.secrets/google-play-service-account.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}
