{
  "expo": {
    "name": "Kouponly",
    "slug": "kouponly",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kouponly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kouponly.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "appleTeamId": "2396PCT42P"
    },
    "android": {
      "package": "com.kouponly.app",
      "icon": "./assets/images/android-adaptive-icon-safe.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-adaptive-icon-safe.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kouponly-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kouponly uses your location to show nearby campus partners."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kouponly uses your photo library to attach your student ID.",
          "cameraPermission": "Kouponly uses the camera to attach your student ID."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bc420d39-140b-47c3-98e8-3f5a7499ae0c"
      }
    },
    "owner": "alcadeus"
  }
}
