{
  "expo": {
    "name": "Kouponly",
    "slug": "kouponly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kouponly-app-icon.png",
    "scheme": "kouponly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kouponly.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "appleTeamId": "2396PCT42P"
    },
    "android": {
      "package": "com.kouponly.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/kouponly-app-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kouponly uses your photo library for your profile picture and creator campaign submissions.",
          "cameraPermission": "Kouponly uses the camera for your profile picture and creator campaign submissions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bc420d39-140b-47c3-98e8-3f5a7499ae0c"
      }
    },
    "owner": "alcadeus"
  }
}
