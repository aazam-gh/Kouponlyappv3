    "expo": "~55.0.31",
    "expo-application": "~55.0.19",
    "expo-asset": "~55.0.20",
    "expo-blur": "~55.0.17",
    "expo-clipboard": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.18",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
